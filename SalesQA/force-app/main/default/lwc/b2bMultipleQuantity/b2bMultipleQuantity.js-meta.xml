<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <isExposed>true</isExposed>

    <masterLabel>Commerce PDP Multiple Quantity</masterLabel>
    <description>Component used on the Checkout page</description>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>

    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="recordId" type="String" label="Record ID" description="O valor deve ser {!recordId}" default="{!recordId}"/>
            <property name="texto" type="String" label="Texto" description="Texto a preceder a quantidade mínima" default="A quantidade deve ser múltiplo de:"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>