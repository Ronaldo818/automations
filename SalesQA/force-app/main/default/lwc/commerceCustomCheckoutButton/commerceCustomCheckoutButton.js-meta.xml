<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <isExposed>true</isExposed>

    <masterLabel>Custom Checkout Button</masterLabel>
    <description>Botão customizado redirecionar o usuário para Checkout</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>

     <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="label" type="String" label="Label" default="Finalizar Pedido" required="true"/>
            <property name="variant" type="String" label="Variant" default="neutral" required="true" datasource="base,neutral,brand,brand-outline,destructive,destructive-text,inverse,success"/>
            <property name="showValue" type="Boolean" label="Exibir Valor do Pedido" default="true"/>
            <property name="stretch" type="Boolean" label="Esticar para Ocupar todo Espaço" default="false"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>