<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <isExposed>true</isExposed>

    <masterLabel>Custom Empty Cart Button</masterLabel>
    <description>Botão customizado para efetuar limpeza do carrinho</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>

     <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="variant" type="String" label="Variant" default="brand" required="true"/>
            <property name="label" type="String" label="Label" default="Limpar Carrinho" required="true"/>
        </targetConfig>
    </targetConfigs>

</LightningComponentBundle>