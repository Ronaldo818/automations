public without sharing class B2BCartCronometerController {

    public class ReturnWrapper{
        String targetTime;
        Decimal hours;
    }


    @AuraEnabled
    public static string getTargetDateTime(String userId){
        ReturnWrapper r = new ReturnWrapper();
        try {
            Contact c = [SELECT Id, CartCronometer__c FROM Contact WHERE Id IN (SELECT ContactId FROM User WHERE Id = :userId) LIMIT 1];

            if(c.CartCronometer__c == null){
                c.CartCronometer__c = DateTime.now();
                update c;
            }
            StandardValue__mdt hoursToAdd = [SELECT Value__c FROM StandardValue__mdt WHERE DeveloperName = 'b2bCartCronHoursToExpire' LIMIT 1];
            r.hours = Decimal.valueOf(hoursToAdd.Value__c);
            r.targetTime = String.valueOf(c.CartCronometer__c.addHours(Integer.valueOf(hoursToAdd.Value__c)).formatGmt('d MMM yyyy HH:mm:ss z'));
            return JSON.serialize(r);
        } catch (Exception e) {
            throw new AuraHandledException(e.getMessage());
        }
    }

