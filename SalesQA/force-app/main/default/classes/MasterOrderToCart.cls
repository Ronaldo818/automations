public with sharing class MasterOrderToCart {

    @AuraEnabled
    public static string masterOrderToCart(String masterOrderId, String accId){
        try {
            ConnectApi.CartSummary cartSum = CommerceUtil.getCartSummary(accId);
            ConnectApi.CommerceCart.deleteCart(cartSum.webstoreId, accId, cartSum.cartId);
            cartSum = ConnectApi.CommerceCart.getOrCreateActiveCartSummary(cartSum.webstoreId, accId, 'active');

            List<ConnectApi.BatchInput> lstItems = new List<ConnectApi.BatchInput>();
            Map<String, MasterOrderItem__c> mapProductIdXMasterOrderItem = new Map<String, MasterOrderItem__c>();
            for(MasterOrderItem__c moi : [SELECT Id, ProductId__c, Quantity__c, NegotiatedUnitPrice__c FROM MasterOrderItem__c WHERE MasterOrderId__c = :masterOrderId]){
                mapProductIdXMasterOrderItem.put(moi.ProductId__c, moi);
                ConnectApi.CartItemInput cii = new ConnectApi.CartItemInput();
                cii.productId = moi.ProductId__c;
                cii.quantity = String.valueOf(moi.Quantity__c);
                cii.type = ConnectApi.CartItemType.PRODUCT;
                lstItems.add(new ConnectApi.BatchInput(cii));
            }

            List<ConnectApi.BatchResult> result;
            if (!Test.isRunningTest()) {
                result = Connectapi.CommerceCart.addItemsToCart(cartSum.webstoreId, accId, cartSum.cartId, lstItems);
            }
            List<CartItem> lstCisToUpdate = new List<CartItem>();
            for(ConnectApi.BatchResult re : result){
                ConnectApi.CartItem item;
                CartItem ci = new CartItem();
                if(re.isSuccess){
                    item = (ConnectApi.CartItem) re.getResult();
                    ci.Id = item.cartItemId;
                    ci.SalesPrice = Decimal.valueOf(item.salesPrice);
                    ci.Product2Id = item.productId;
                    ci.Quantity = Decimal.valueOf(item.quantity);
                    lstCisToUpdate.add(ci);
                }
            }

            FvCartController.setUpNegotiatedPriceOnCartItems(lstCisToUpdate, mapProductIdXMasterOrderItem);
            update lstCisToUpdate;

            return '{"success": true}';
        } catch (Exception e) {
            throw new AuraHandledException(e.getMessage());
        }
    }

