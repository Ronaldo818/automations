<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <isExposed>true</isExposed>

    <masterLabel>FV - Product Quantity and Price Selector</masterLabel>
    <description>FV - PLP component</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>

     <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="product" type="String" placeholder="Product data LWR expresion" label="Product Data" default="{!Product.Details}" required="true"/>
            <property name="productPricing" type="String" placeholder="Product data LWR expresion" label="Product Pricing Data" default="{!Product.Pricing}" required="true"/>
            <property name="effectiveAccountId" type="String" placeholder="Effective Account data LWR expresion" label="Effective Account Id" default="{!User.Commerce.EffectiveAccount.id}" required="true"/>
        </targetConfig>
    </targetConfigs>

</LightningComponentBundle>