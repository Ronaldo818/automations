<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <isExposed>true</isExposed>

    <masterLabel>Commerce Custom Payment</masterLabel>
    <description>Component used on the Payment section</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
    <targetConfig targets="lightningCommunity__Default">
      <property 
        label="Error Message" 
        name="error" 
        type="String" 
        default="Escolha uma forma de pagamento."/>
      <property 
        label="recordId" 
        name="recordId" 
        type="String" 
        default="{!recordId}"/>
    </targetConfig>
    </targetConfigs>
</LightningComponentBundle>