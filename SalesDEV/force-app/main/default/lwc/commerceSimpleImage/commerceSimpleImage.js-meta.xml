<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <isExposed>true</isExposed>

    <masterLabel>Simple Image</masterLabel>
    <description>Display an image given url</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>

    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="url" type="String" label="Image URL" default="{!Site.basePath}/sfsites/c/cms/delivery/media/{!Product.Details.fields.TabelaNutricional__c}"/>
            <property name="customStyle" type="String" label="Container Style" default="" placeholder="Use CSS sintax"/>

        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>